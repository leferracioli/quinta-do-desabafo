---
// Página de venda de um e-book: /ebook/<slug>/ (dados em src/lib/ebooks.ts)
import { Image, getImage } from 'astro:assets';
import Venda from '../../layouts/Venda.astro';
import { EBOOKS, DADOS, CAPITULOS, FAQ, EMPRESAS, type Ebook } from '../../lib/ebooks';
import foto from '../../assets/leticia.webp';

export function getStaticPaths() {
  return EBOOKS.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props as { e: Ebook };
const og = await getImage({ src: e.capa, width: 600, format: 'jpg' });
---
<Venda title={`${e.nome} · Letícia Ferracioli`} description={e.subtitulo} imagem={og.src}>

  <section class="hero"><div class="wrap grid">
    <div>
      <div class="eyebrow">E-book para gestores comerciais</div>
      <h1>{e.nomeAntes}<em>{e.nomeDestaque}</em></h1>
      <p class="lead">{e.subtitulo}</p>
      <p class="hook">{e.gancho}</p>
      {e.filtro && <p class="filtro">{e.filtro}</p>}
      <a class="btn" href={e.checkout} data-checkout data-ebook={e.slug} data-preco={e.preco}>Quero o e-book por R$ {e.preco}</a>
      <p class="small">Acesso imediato · Planilha e painel inclusos · 7 dias de garantia</p>
    </div>
    <Image class="cover" src={e.capa} alt={`Capa do e-book ${e.nome}`} width={420} loading="eager" />
  </div></section>

  <section class="dor"><div class="wrap">
    <h2>{e.dorTitulo}</h2>
    {e.dor.map((p) => <p>{p}</p>)}
  </div></section>

  <section><div class="wrap">
    <h2>{e.pilaresTitulo}</h2>
    <div class="pilares">
      {e.pilares.map(([t, d], i) => (
        <div class="card"><div class="n">0{i + 1}</div><h3>{t}</h3><p>{d}</p></div>
      ))}
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="eyebrow espaco">O que a pesquisa já mediu</div>
    <h2>Velocidade e persistência valem mais do que parece</h2>
    <div class="dados">
      {DADOS.map(([n, t, f]) => <div class="dado"><b>{n}</b><span>{t}</span><i>{f}</i></div>)}
    </div>
    <p class="nota">Do outro lado, o consumidor brasileiro aceita receber mensagem de empresa cerca de uma vez por semana (Opinion Box, 2025). A saída não é mandar mais mensagens. É mandar mensagens melhores, no momento certo, cada uma com um motivo.</p>
  </div></section>

  <section><div class="wrap">
    <h2>Com o e-book, você vai</h2>
    <ul class="check">{e.resultados.map((r) => <li>{r}</li>)}</ul>
    <a class="btn" href={e.checkout} data-checkout data-ebook={e.slug} data-preco={e.preco}>Quero o e-book por R$ {e.preco}</a>
  </div></section>

  <section><div class="wrap">
    <h2>O que tem dentro</h2>
    <div class="caps">
      {CAPITULOS.map(([n, t, d]) => (
        <div class:list={['cap', { destaque: n === '8' }]}><div class="num">{n}</div><div><b>{t}</b><span>{d}</span></div></div>
      ))}
    </div>
  </div></section>

  <section><div class="wrap">
    <h2>Dois bônus para colocar em prática</h2>
    <div class="duas">
      <div class="card"><div class="n">Bônus 1</div><h3>Planilha de medição antes e depois</h3><p>Registre as últimas 50 conversas antes de mudar qualquer coisa e as 50 depois de 30 dias. O painel calcula sozinho velocidade, cobertura e conversão, e mostra a variação.</p></div>
      <div class="card"><div class="n">Bônus 2</div><h3>Painel do time</h3><p>Uma planilha pronta que mostra, por vendedor, follow-ups atrasados, conversas paradas esperando o time, velocidade, cobertura e conversão. E um prompt para o ChatGPT, Claude ou Gemini adaptar o painel ao seu CRM.</p></div>
    </div>
  </div></section>

  <section><div class="wrap">
    <h2>É para você?</h2>
    <div class="duas">
      <div class="card sim"><h3>É para você se</h3><ul>
        <li>Lidera um time que vende por WhatsApp, Direct, e-mail ou telefone</li>
        <li>Desconfia que tem venda parada que ninguém retomou</li>
        <li>Quer acompanhar o time por número, não por impressão</li>
        <li>Precisa de um padrão para treinar quem chega</li></ul></div>
      <div class="card nao"><h3>Não é para você se</h3><ul>
        <li>Procura disparo em massa ou automação de mensagens</li>
        <li>Quer fórmula mágica sem mudar a rotina do time</li>
        <li>Vende só em loja física, sem conversa depois do primeiro contato</li></ul></div>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="autora">
      <Image class="foto" src={foto} alt="Letícia Ferracioli" width={280} />
      <div>
        <div class="eyebrow espaco">Quem escreveu</div>
        <h2 class="nome">Letícia Ferracioli</h2>
        <p class="cargo">Supervisora comercial · no marketing digital desde 2018</p>
        <p>Começou como vendedora, foi para a liderança e, desde então, trabalha com o que sustenta uma operação comercial: equipe, processo, indicador, CRM e automação.</p>
        <p>O método deste e-book junta o que a pesquisa já mediu com o que ela aplica no dia a dia com o time: atendimentos organizados por dia, régua de retorno, rotina semanal de acompanhamento e repescagem no fim do mês.</p>
      </div>
    </div>
    <div class="stats">
      <div><b>+R$ 20 mi</b><span>em vendas organizadas ao longo da carreira, nas operações comerciais que estruturou</span></div>
      <div><b>8 anos</b><span>entre marketing digital e gestão comercial</span></div>
    </div>
    <div class="marcas">
      <div class="eyebrow">Algumas das empresas e marcas em que já trabalhou</div>
      <div class="cartoes">{EMPRESAS.filter((e) => e.contexto).map((e) => <div><b>{e.nome}</b><span>{e.contexto}</span></div>)}</div>
      <ul>{EMPRESAS.filter((e) => !e.contexto).map((e) => <li>{e.nome}</li>)}</ul>
    </div>
  </div></section>

  <section class="oferta"><div class="wrap">
    <div class="box">
      <div class="eyebrow">{e.nome}</div>
      <div class="preco"><small>R$</small>{e.preco}</div>
      <p class="small">Pagamento único</p>
      <ul>
        <li>E-book completo em PDF, com 8 capítulos</li>
        <li>28 mensagens prontas por situação</li>
        <li>Cadência de 30 dias e plano de implantação de 7 dias</li>
        <li>Bônus 1: planilha de medição antes e depois</li>
        <li>Bônus 2: painel de acompanhamento do time</li>
      </ul>
      <a class="btn" href={e.checkout} data-checkout data-ebook={e.slug} data-preco={e.preco}>Comprar agora por R$ {e.preco}</a>
      <p class="garantia">7 dias de garantia pela Hotmart. Não serviu, você pede o reembolso.</p>
    </div>
  </div></section>

  <section><div class="wrap">
    <h2>Perguntas frequentes</h2>
    {FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
  </div></section>

  <footer><div class="wrap">
    © {new Date().getFullYear()} Letícia Ferracioli · Pagamento processado pela Hotmart<br />
    <a href="/privacidade/">Privacidade</a> · <a href="#" data-preferencias-cookies>Preferências de cookies</a>
  </div></footer>
</Venda>

<style is:global>
  body.venda{--carvao:#201b18;--laranja:#d69b74;--bg:#121010;--bg2:#1a1614;--card:#201b18;--ink:#f3ece6;--muted:#b3a79e;--cu:#d69b74;--cu2:#b8784f;--line:#2e2623;
    margin:0;background:var(--bg);color:var(--ink);font-family:'Jost',system-ui,-apple-system,'Segoe UI',sans-serif;line-height:1.6;font-size:18px;-webkit-font-smoothing:antialiased}
  .venda *{box-sizing:border-box}
  .venda h1,.venda h2,.venda h3,.venda p,.venda ul{margin:0;padding:0}
  .venda .wrap{max-width:1040px;margin:0 auto;padding:0 22px}
  .venda em{font-style:normal;color:var(--cu)}
  .venda .eyebrow{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
  .venda .espaco{margin-bottom:12px}
  .venda h1{font-size:clamp(42px,7vw,70px);line-height:1.02;font-weight:700;letter-spacing:-.015em;margin:14px 0 18px}
  .venda h2{font-size:clamp(28px,4.4vw,40px);line-height:1.12;font-weight:700;letter-spacing:-.01em;margin-bottom:22px}
  .venda .lead{font-size:21px;opacity:.92;max-width:34ch}
  .venda section{padding:76px 0;border-top:1px solid var(--line)}
  .venda .hero{padding:56px 0 70px;border:0;background:radial-gradient(ellipse at 80% 20%,rgba(214,155,116,.12),transparent 55%)}
  .venda .hero .grid{display:grid;grid-template-columns:1.15fr .85fr;gap:48px;align-items:center}
  .venda .hook{margin-top:26px;padding-left:16px;border-left:2px solid var(--cu);color:var(--muted);max-width:38ch}
  .venda .filtro{margin-top:18px;font-size:16px;color:var(--muted);max-width:44ch}
  .venda .cover{width:100%;height:auto;max-width:360px;border-radius:6px;box-shadow:0 30px 60px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.04);justify-self:center;transform:rotate(1.2deg)}
  .venda .btn{display:inline-block;background:var(--cu);color:#1a1210;font-weight:700;text-decoration:none;padding:17px 30px;border-radius:999px;font-size:18px;margin-top:30px;transition:background .2s}
  .venda .btn:hover{background:#e5ad88}
  .venda .small{font-size:14px;color:var(--muted);margin-top:12px}
  .venda .dor p{font-size:20px;max-width:62ch;margin-bottom:18px;color:#e4dad2}
  .venda .dor p:last-child{color:var(--cu);font-weight:600}
  .venda .pilares{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .venda .duas{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .venda .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:26px}
  .venda .card .n{font-size:13px;color:var(--cu);letter-spacing:.18em;text-transform:uppercase;font-weight:600}
  .venda .card h3{font-size:22px;font-weight:600;margin:8px 0}
  .venda .card p{color:var(--muted);font-size:17px}
  .venda .card ul{list-style:none;display:grid;gap:10px;margin-top:10px}
  .venda .card li{color:#e4dad2;font-size:17px;padding-left:22px;position:relative}
  .venda .sim li:before{content:'+';position:absolute;left:0;color:var(--cu);font-weight:700}
  .venda .nao li:before{content:'–';position:absolute;left:0;color:var(--muted);font-weight:700}
  .venda .dados{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .venda .dado b{display:block;font-size:42px;font-weight:700;color:var(--cu);line-height:1.1}
  .venda .dado span{display:block;font-size:16px;color:#e4dad2;margin-top:6px}
  .venda .dado i{display:block;font-style:normal;font-size:13px;color:var(--muted);margin-top:8px}
  .venda .nota{margin-top:26px;color:var(--muted);font-size:16px;max-width:70ch}
  .venda ul.check{list-style:none;display:grid;gap:14px;max-width:720px}
  .venda ul.check li{padding-left:34px;position:relative;font-size:19px}
  .venda ul.check li:before{content:'';position:absolute;left:0;top:7px;width:18px;height:18px;border-radius:50%;border:2px solid var(--cu);background:radial-gradient(circle,var(--cu) 35%,transparent 40%)}
  .venda .caps{display:grid;grid-template-columns:repeat(2,1fr);gap:0 36px}
  .venda .cap{display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--line)}
  .venda .cap .num{color:var(--cu);font-weight:700;font-size:16px;min-width:28px;padding-top:2px}
  .venda .cap b{display:block;font-size:18px;font-weight:600}
  .venda .cap span{color:var(--muted);font-size:16px}
  .venda .cap.destaque b:after{content:'Novo';margin-left:8px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;background:var(--cu);color:#1a1210;padding:2px 8px;border-radius:99px;vertical-align:middle}
  .venda .autora{display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:start;max-width:780px}
  .venda .autora .foto{width:140px;height:140px;border-radius:50%;object-fit:cover;object-position:50% 18%;border:2px solid var(--cu2)}
  .venda .autora p{color:#e4dad2;margin-bottom:12px}
  .venda .autora .nome{margin-bottom:6px}
  .venda .autora .cargo{color:var(--cu);font-weight:600;font-size:16px;margin-bottom:16px}
  .venda .stats{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:40px;max-width:600px}
  .venda .stats div{border-top:2px solid var(--cu);padding-top:14px}
  .venda .stats b{display:block;font-size:40px;font-weight:700;line-height:1.1}
  .venda .stats span{display:block;color:var(--muted);font-size:16px;margin-top:6px}
  .venda .marcas{margin-top:44px;max-width:880px}
  .venda .marcas ul{list-style:none;display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
  .venda .marcas li{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:8px 16px;font-size:16px;color:#e4dad2}
  .venda .marcas li b{font-weight:500}
  .venda .cartoes{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:14px}
  .venda .cartoes div{background:var(--card);border:1px solid var(--line);border-left:2px solid var(--cu);border-radius:10px;padding:14px 18px}
  .venda .cartoes b{display:block;font-weight:600;font-size:16px}
  .venda .cartoes span{display:block;color:var(--muted);font-size:15px;margin-top:4px;line-height:1.45}
  .venda .oferta{background:linear-gradient(180deg,var(--bg2),var(--bg));text-align:center}
  .venda .box{max-width:560px;margin:0 auto;background:var(--card);border:1px solid var(--cu2);border-radius:18px;padding:40px 32px}
  .venda .box ul{list-style:none;text-align:left;display:grid;gap:10px;margin:22px 0}
  .venda .box li{padding-left:26px;position:relative;color:#e4dad2;font-size:17px}
  .venda .box li:before{content:'✓';position:absolute;left:0;color:var(--cu);font-weight:700}
  .venda .preco{font-size:58px;font-weight:700;line-height:1;margin-top:10px}
  .venda .preco small{font-size:22px;vertical-align:top;margin-right:4px}
  .venda .garantia{margin-top:18px;font-size:14px;color:var(--muted)}
  .venda details{border-bottom:1px solid var(--line);padding:18px 0;max-width:760px}
  .venda summary{cursor:pointer;font-weight:600;font-size:19px;list-style:none}
  .venda summary::-webkit-details-marker{display:none}
  .venda summary:after{content:'+';float:right;color:var(--cu);font-weight:700}
  .venda details[open] summary:after{content:'–'}
  .venda details p{color:var(--muted);margin-top:10px}
  .venda footer{padding:36px 0 50px;border-top:1px solid var(--line);color:var(--muted);font-size:14px;text-align:center}
  .venda footer a{color:var(--muted)}
  @media (max-width:820px){
    .venda .hero .grid{grid-template-columns:1fr;gap:34px}
    .venda .hero .grid>div:first-child{order:2}
    .venda .cover{max-width:250px}
    .venda .pilares,.venda .dados,.venda .duas,.venda .caps,.venda .stats,.venda .cartoes{grid-template-columns:1fr}
    .venda .autora{grid-template-columns:1fr}
    .venda section{padding:56px 0}
  }
</style>
