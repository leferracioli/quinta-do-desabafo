---
// Projetos: estudos de caso anonimizados (dados em src/lib/projetos.ts).
import Base from '../../layouts/Base.astro';
import Ilustracao from '../../components/Ilustracao.astro';
import Movimento from '../../components/Movimento.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import { PROJETOS, PRINCIPIOS } from '../../lib/projetos';
import { numeroEdicao } from '../../lib/artigos';
import { migalhas, idPessoa } from '../../lib/seo';

const site = Astro.site!;
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Projetos',
    url: new URL('/projetos/', site).href,
    inLanguage: 'pt-BR',
    author: { '@id': idPessoa(site) },
    hasPart: PROJETOS.map((p) => ({ '@type': 'Article', headline: p.titulo, url: new URL(`/projetos/${p.slug}/`, site).href })),
  },
  migalhas(site, [{ nome: 'Início', caminho: '/' }, { nome: 'Projetos', caminho: '/projetos/' }]),
];
---
<Base
  title="Projetos · Letícia Ferracioli"
  description="Problemas reais de operações comerciais e as ferramentas que construí para eles: painéis, radares, análise de atendimento com IA e estudos de dados."
  imagem="/og/inicio.png"
  jsonLd={jsonLd}
>
  <header class="topo-pagina escuro pontos">
    <div class="wrap">
      <p class="kicker">Projetos</p>
      <h1>O que eu já <span class="destaque">construí</span></h1>
      <p class="lead">Problemas reais de operações comerciais e as ferramentas que eu construí para eles. Os nomes ficam de fora, por respeito a quem confiou a operação a mim. O raciocínio está todo aqui.</p>
    </div>
  </header>

  <section class="dobra wrap principios" aria-labelledby="principios">
    <h2 id="principios" class="revela">Como eu leio <span class="destaque">dados</span></h2>
    <ol>
      {PRINCIPIOS.map((p, i) => (
        <li class="revela"><span class="rotulo">Regra {i + 1}</span><h3>{p.titulo}</h3><p>{p.texto}</p></li>
      ))}
    </ol>
  </section>

  <section class="dobra lista" aria-label="Lista de projetos">
    <div class="wrap">
      {PROJETOS.map((p, i) => (
        <a class="caso revela" href={`/projetos/${p.slug}/`}>
          <Ilustracao tipo={p.ilustracao} legenda={p.legenda} />
          <div>
            <div class="caso-topo"><span class="n">{numeroEdicao(i + 1)}</span><span class:list={['selo', p.status === 'Estudo' && 'cinza']}>{p.status}</span><span class="rotulo">{p.contexto}</span></div>
            <h2>{p.titulo}</h2>
            <p>{p.resumo}</p>
            <span class="link">Ler o caso →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="dobra wrap fim" aria-labelledby="fim">
    <h2 id="fim" class="revela">Tem uma pergunta que os seus dados ainda não <span class="destaque">respondem</span>?</h2>
    <p class="revela">Cada projeto começa por uma conversa sobre o que você precisa enxergar. Pode ser dentro de uma consultoria ou como projeto à parte.</p>
    <div class="acoes revela">
      <a class="botao" href="/solucoes/#inteligencia">Ver como funciona →</a>
      <BotaoWhatsapp variante="claro" texto="Conversar no WhatsApp" />
    </div>
  </section>
  <Movimento />
</Base>

<style>
  .pontos { background-image: radial-gradient(rgba(239, 234, 227, 0.07) 1px, transparent 1.2px); background-size: 22px 22px; }
  .topo-pagina { padding-block: clamp(56px, 8vw, 110px) clamp(48px, 6vw, 80px); }
  h1 { font-size: clamp(var(--fs-4), 7vw, var(--fs-7)); letter-spacing: -0.02em; margin: 0.3em 0 0.4em; }
  .lead { font-size: clamp(1.2rem, 1.9vw, var(--fs-2)); line-height: 1.45; max-width: 44ch; margin: 0; color: #dcd6cd; }

  .principios { padding-block: clamp(56px, 8vw, 100px); }
  .principios > h2 { font-size: clamp(2rem, 3.6vw, var(--fs-4)); margin-bottom: clamp(28px, 4vw, 48px); }
  .principios ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(20px, 3vw, 40px); }
  .principios li { border-top: 1px solid var(--carvao); padding-top: 1rem; }
  .principios .rotulo { color: var(--laranja-tinta); }
  .principios h3 { font-size: 1.4rem; line-height: 1.15; margin: 0.6rem 0 0.5rem; }
  .principios p { margin: 0; font-size: 1.02rem; line-height: 1.55; color: var(--taupe-pedra); }

  .lista { background: var(--branco); padding-block: clamp(40px, 6vw, 80px); }
  .caso { display: grid; grid-template-columns: minmax(220px, 4fr) 7fr; gap: clamp(24px, 4vw, 64px); padding: clamp(28px, 4vw, 44px) 0; border-top: 1px solid var(--carvao); text-decoration: none; }
  .caso:first-child { border-top: 0; }
  .caso-topo { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .n { font-family: var(--serif); font-size: var(--fs-3); line-height: 1; color: var(--taupe-tinta); }
  .caso h2 { font-size: clamp(1.6rem, 3vw, var(--fs-4)); margin: 0.6rem 0; max-width: 20ch; }
  .caso p { margin: 0 0 1rem; max-width: 56ch; color: var(--taupe-pedra); }
  .caso .link { font-weight: 500; }
  .caso:hover h2 { text-decoration: underline; text-decoration-color: var(--laranja); text-underline-offset: 0.12em; text-decoration-thickness: 2px; }

  .fim { padding-block: clamp(56px, 8vw, 110px); }
  .fim h2 { font-size: clamp(2rem, 3.6vw, var(--fs-4)); max-width: 22ch; margin-bottom: 0.5em; }
  .fim p { max-width: 52ch; }
  .acoes { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 1.6rem; }
  .botao { display: inline-flex; text-decoration: none; font: 500 var(--fs-0) var(--sans); letter-spacing: 0.12em; text-transform: uppercase; padding: 1.05rem 1.7rem; background: var(--carvao); color: var(--areia); box-shadow: inset 0 -3px 0 var(--laranja); }

  @media (max-width: 1000px) { .principios ol { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) { .caso { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .principios ol { grid-template-columns: 1fr; } }
</style>
