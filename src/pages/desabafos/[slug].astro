---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TituloDestaque from '../../components/TituloDestaque.astro';
import Progresso from '../../components/artigo/Progresso.astro';
import Indice, { type ItemIndice } from '../../components/artigo/Indice.astro';
import ProximoDesabafo from '../../components/artigo/ProximoDesabafo.astro';
import FormTema from '../../components/form/FormTema.astro';
import ChamadaDiagnostico from '../../components/ChamadaDiagnostico.astro';
import { getArtigos, tempoLeitura, dataLonga, numeroEdicao, type Artigo } from '../../lib/artigos';
import foto from '../../assets/leticia.webp';
import { grafoArtigo } from '../../lib/seo';
import '../../styles/artigo.css';

// Componentes que o MDX pode usar sem import
import Ref from '../../components/artigo/Ref.astro';
import Nota from '../../components/artigo/Nota.astro';
import Dado from '../../components/artigo/Dado.astro';
import Citacao from '../../components/artigo/Citacao.astro';
import Vozes from '../../components/artigo/Vozes.astro';
import Voz from '../../components/artigo/Voz.astro';
import Desabafo from '../../components/artigo/Desabafo.astro';
import Pendente from '../../components/artigo/Pendente.astro';
import Pergunta from '../../components/artigo/Pergunta.astro';

export async function getStaticPaths() {
  const artigos = await getArtigos();
  return artigos.map((artigo) => ({ params: { slug: artigo.data.slug }, props: { artigo, artigos } }));
}

const { artigo, artigos } = Astro.props as { artigo: Artigo; artigos: Artigo[] };
const d = artigo.data;
const { Content, headings } = await render(artigo);
const minutos = tempoLeitura(artigo);

// Índice: os H2 do texto + as seções de componente (vozes, desabafo), na ordem em que aparecem
const corpo = artigo.body ?? '';
const itens: (ItemIndice & { pos: number })[] = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, texto: h.text, pos: corpo.indexOf(`## ${h.text}`) }));
for (const [tag, id, texto] of [['<Vozes', 'vozes', 'O que outras pessoas estão dizendo?'], ['<Desabafo', 'desabafo', 'O desabafo']]) {
  const pos = corpo.indexOf(tag);
  if (pos >= 0) itens.push({ id, texto, pos });
}
itens.sort((a, b) => a.pos - b.pos);
if (d.faq.length) itens.push({ id: 'faq', texto: 'Perguntas frequentes', pos: Infinity });

// Imagem de compartilhamento: a capa (se houver), recortada em 1200×630; senão, a gerada automaticamente
const imagemOg = d.capa
  ? (await getImage({ src: d.capa, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : `/og/${d.slug}.png`;
const jsonLd = grafoArtigo(artigo, Astro.site!, new URL(imagemOg, Astro.site).href);
---
<Base
  title={d.title}
  description={d.description}
  imagem={imagemOg}
  imagemAlt={d.capaAlt}
  tipo="article"
  publicadoEm={d.publishedAt}
  atualizadoEm={d.updatedAt}
  naoIndexar={d.draft}
  jsonLd={jsonLd}
>
  <Progresso />
  <article>
    <header class="abertura escuro">
      <div class="wrap abertura-grid">
        <p class="kicker">{d.tema} · Desabafo Nº {numeroEdicao(d.edicao)} · {minutos} min de leitura</p>
        <TituloDestaque titulo={d.title} destaque={d.palavraDestaque} />
        <p class="lead">{d.resumoDireto}</p>
        <div class="autora">
          <Image src={foto} alt="" width={104} densities={[1]} />
          <div>
            <b><a href="/sobre/">Letícia Ferracioli</a></b>
            <span>
              <time datetime={d.publishedAt.toISOString().slice(0, 10)}>{dataLonga(d.publishedAt)}</time>
              {d.updatedAt && <> · atualizado em <time datetime={d.updatedAt.toISOString().slice(0, 10)}>{dataLonga(d.updatedAt)}</time></>}
            </span>
          </div>
        </div>
      </div>
    </header>

    <div class="leitura">
      <Indice itens={itens} variante="lateral" />

      <div class="corpo">
        <Indice itens={itens} variante="movel" />
        <Content components={{ Ref, Nota, Dado, Citacao, Vozes, Voz, Desabafo, Pendente, Pergunta }} />
      </div>

      <div class="corpo fim">
        {d.faq.length > 0 && (
          <section class="faq" aria-labelledby="faq">
            <h2 id="faq">Perguntas frequentes</h2>
            {d.faq.map((f) => (
              <details>
                <summary>{f.pergunta}</summary>
                <p>{f.resposta}</p>
              </details>
            ))}
          </section>
        )}

        {d.fontes.length > 0 && (
          <section class="fontes" aria-labelledby="fontes">
            <h2 id="fontes">Fontes</h2>
            <ol>
              {d.fontes.map((f, i) => (
                <li id={`fonte-${i + 1}`}>
                  {f.titulo}{' '}
                  {f.url ? <a class="link" href={f.url} rel="noopener">link ↗</a> : <mark class="pendente">[ link pendente ]</mark>}
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
    </div>

    <FormTema />
    <ChamadaDiagnostico />
    <ProximoDesabafo atual={artigo} artigos={artigos} />
  </article>
</Base>
