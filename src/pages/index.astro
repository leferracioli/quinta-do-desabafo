---
// Home: quem é a Letícia, as soluções, o Desabafo da semana e o contato.
import Base from '../layouts/Base.astro';
import Retrato from '../components/Retrato.astro';
import TituloDestaque from '../components/TituloDestaque.astro';
import BotaoWhatsapp from '../components/BotaoWhatsapp.astro';
import FormLead from '../components/form/FormLead.astro';
import { getArtigos, numeroEdicao, primeirasFrases } from '../lib/artigos';
import { SOLUCOES } from '../lib/solucoes';
import { siteWeb, pessoaRef, servicos } from '../lib/seo';

const [atual] = await getArtigos();
const jsonLd = [siteWeb(Astro.site!), pessoaRef(Astro.site!), ...servicos(Astro.site!)];
---
<Base
  title="Letícia Ferracioli · Mentoria e consultoria comercial"
  description="Mentoria e consultoria comercial com Letícia Ferracioli: equipes, processos, indicadores, CRM e automações. E toda quinta, a Quinta do Desabafo."
  imagem="/og/inicio.png"
  jsonLd={jsonLd}
>
  <section class="hero escuro">
    <div class="wrap hero-grade">
      <div class="hero-texto">
        <p class="kicker">Mentoria e consultoria comercial</p>
        <h1>Vendas e gestão comercial, sem fórmula <span class="destaque">mágica</span>.</h1>
        <p class="lead">Sou a Letícia Ferracioli. Trabalho com marketing digital desde 2018 e hoje atuo na gestão comercial: equipes, processos, indicadores, CRM e automações.</p>
        <div class="acoes">
          <BotaoWhatsapp variante="claro" />
          <a class="link" href="/solucoes/">Conheça as soluções →</a>
        </div>
      </div>
      <div class="hero-foto"><Retrato prioridade sizes="(max-width: 900px) 64vw, 420px" /></div>
    </div>
  </section>

  <section class="wrap solucoes" aria-labelledby="como-ajudo">
    <div class="cabeca">
      <p class="kicker">Soluções</p>
      <h2 id="como-ajudo">Como eu posso ajudar</h2>
    </div>
    <div class="lista">
      {SOLUCOES.map((s, i) => (
        <article class="solucao">
          <span class="num" aria-hidden="true">{numeroEdicao(i + 1)}</span>
          <TituloDestaque tag="h3" titulo={s.nome} destaque={s.destaque} />
          <p class="para-quem">{s.paraQuem}</p>
          <p>{s.resumo}</p>
          <a class="link" href={`/solucoes/#${s.id}`}>Saber mais sobre a {s.nome.toLowerCase()} →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="quinta escuro" aria-labelledby="quinta">
    <div class="wrap quinta-grade">
      <div>
        <p class="kicker">Toda quinta-feira</p>
        <h2 id="quinta">Quinta do <span class="destaque">Desabafo</span></h2>
        <p class="sobre-quinta">Uma notícia da semana sobre vendas, gestão comercial, IA ou marketing digital, além da manchete: dados, outras vozes e o que eu vejo na prática.</p>
      </div>
      <div class="edicao">
        {atual ? (
          <>
            <p class="kicker">Nº {numeroEdicao(atual.data.edicao)} · {atual.data.tema}</p>
            <a class="titulo-edicao" href={`/desabafos/${atual.data.slug}/`}>
              <TituloDestaque tag="h3" titulo={atual.data.title} destaque={atual.data.palavraDestaque} />
            </a>
            <p>{primeirasFrases(atual.data.resumoDireto, 2)}</p>
            <p class="links"><a class="link" href={`/desabafos/${atual.data.slug}/`}>Ler o desabafo →</a><a class="link" href="/desabafos/">Todas as edições →</a></p>
          </>
        ) : (
          <p>O primeiro desabafo sai na próxima quinta.</p>
        )}
      </div>
    </div>
  </section>

  <section class="wrap contato" id="contato" aria-labelledby="conversar">
    <div class="contato-texto">
      <p class="kicker">Contato</p>
      <h2 id="conversar">Vamos <span class="destaque">conversar</span>?</h2>
      <p>Me conta o seu momento. A conversa começa entendendo o que está acontecendo na sua operação ou na sua liderança.</p>
      <BotaoWhatsapp />
      <p class="ou">ou deixe seus dados que eu te chamo:</p>
    </div>
    <FormLead />
  </section>
</Base>

<style>
  .hero { padding-block: clamp(48px, 7vw, 100px) 0; overflow: hidden; }
  .hero-grade { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--gutter); align-items: end; }
  .hero-texto { grid-column: 1 / span 7; align-self: center; padding-bottom: clamp(48px, 7vw, 100px); }
  h1 { font-size: clamp(var(--fs-4), 6.4vw, var(--fs-6)); letter-spacing: -0.015em; margin: 0.4em 0 0.45em; }
  .lead { font-size: var(--fs-2); line-height: 1.45; max-width: 32ch; margin: 0 0 1.8em; }
  .acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem 2rem; font-weight: 500; }
  .hero-foto { grid-column: 8 / span 5; padding-top: 60px; }

  .solucoes { padding-block: clamp(64px, 9vw, 120px); }
  .cabeca { border-top: 1px solid var(--carvao); padding-top: 1.2rem; margin-bottom: clamp(32px, 5vw, 56px); }
  .cabeca h2 { font-size: var(--fs-4); margin-top: 0.3em; }
  .lista { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); }
  .solucao .num { font-family: var(--serif); font-weight: var(--peso-serif); font-size: var(--fs-5); line-height: 1; color: var(--pedra); }
  .solucao :global(h3) { font-size: var(--fs-3); margin: 0.2em 0 0.4em; }
  .para-quem { font-weight: 500; }
  .solucao p { margin: 0 0 1em; max-width: 46ch; }
  .solucao .link { font-weight: 500; }

  .quinta { padding-block: clamp(64px, 9vw, 120px); }
  .quinta-grade { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); }
  .quinta h2 { font-size: var(--fs-4); margin: 0.3em 0 0.4em; }
  .sobre-quinta { color: var(--areia); margin: 0; max-width: 38ch; }
  .edicao { border-top: 1px solid var(--linha-escura); padding-top: 1.2rem; }
  .titulo-edicao { text-decoration: none; }
  .titulo-edicao :global(h3) { font-size: var(--fs-3); margin: 0.3em 0 0.5em; }
  .titulo-edicao:hover :global(h3) { text-decoration: underline; text-decoration-color: var(--laranja); text-underline-offset: 0.12em; }
  .edicao p { max-width: 52ch; }
  .links { display: flex; flex-wrap: wrap; gap: 0.8rem 2rem; font-weight: 500; }

  .contato { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); padding-block: clamp(64px, 9vw, 120px); }
  .contato h2 { font-size: var(--fs-4); margin: 0.3em 0 0.4em; }
  .contato-texto p:not(.kicker) { max-width: 38ch; }
  .ou { color: var(--taupe-tinta); font-size: var(--fs-0); margin-top: 1.6rem; }

  @media (max-width: 900px) {
    .hero-texto, .hero-foto { grid-column: 1 / -1; }
    .hero-foto { order: -1; max-width: 280px; width: 70%; margin: 30px auto 0 1.6rem; padding-top: 50px; }
    .hero-texto { padding-bottom: 56px; }
    .lead { font-size: 1.35rem; }
    .lista, .quinta-grade, .contato { grid-template-columns: 1fr; }
  }
</style>
