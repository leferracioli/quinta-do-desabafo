---
// "Sugira um tema para a próxima quinta": fica no fim de cada artigo.
// Grava na aba "Temas sugeridos" da planilha via /api/formulario.
import Origem from './Origem.astro';
---
<section class="sugestao" aria-labelledby="sugira">
  <div class="wrap grade">
    <div class="chamada">
      <p class="kicker">Próximas quintas</p>
      <h2 id="sugira">Sugira um <span class="destaque">desabafo</span></h2>
      <p>Tem uma notícia, uma prática do mercado ou uma "verdade absoluta" de vendas que merece ser questionada? Manda pra cá. As sugestões entram na pauta das próximas edições.</p>
    </div>
    <form class="form" method="post" action="/api/formulario" data-origem>
      <input type="hidden" name="tipo" value="tema" />
      <Origem />
      <label>
        <span>Qual tema você quer ver aqui? *</span>
        <textarea name="tema" rows="3" required minlength="3" maxlength="600"></textarea>
      </label>
      <div class="linha">
        <label><span>Nome <small>(opcional)</small></span><input name="nome" maxlength="120" autocomplete="name" /></label>
        <label><span>E-mail <small>(opcional, para eu te avisar)</small></span><input name="email" type="email" maxlength="160" autocomplete="email" /></label>
      </div>
      <label class="armadilha" aria-hidden="true">Site <input name="site" tabindex="-1" autocomplete="off" /></label>
      <label class="consentimento">
        <input type="checkbox" name="consentimento" value="sim" required />
        <span>Concordo com a <a href="/privacidade/">política de privacidade</a>.</span>
      </label>
      <button type="submit">Enviar sugestão</button>
    </form>
  </div>
</section>

<style>
  .sugestao { border-top: 1px solid var(--carvao); padding-block: clamp(56px, 8vw, 100px); }
  .grade { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  h2 { font-size: var(--fs-4); margin: 0.3em 0 0.4em; }
  .chamada p:not(.kicker) { margin: 0; line-height: 1.55; }
  .form { display: grid; gap: 1.1rem; font-size: var(--fs-0); }
  .linha { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  label > span { display: block; font-weight: 500; letter-spacing: 0.06em; margin-bottom: 0.35rem; }
  small { font-weight: 400; color: var(--taupe-tinta); }
  input:not([type='checkbox']), textarea {
    width: 100%; font: inherit; font-size: 1rem; color: var(--carvao);
    background: var(--branco); border: 1px solid var(--pedra); border-radius: 2px; padding: 0.75rem 0.85rem;
  }
  input:focus, textarea:focus { outline: 2px solid var(--laranja); outline-offset: 1px; border-color: var(--carvao); }
  .consentimento { display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.45; }
  .consentimento span { font-weight: 400; letter-spacing: 0; margin: 0; }
  .consentimento input { margin-top: 0.2rem; accent-color: var(--carvao); }
  .consentimento a { color: var(--carvao); }
  .armadilha { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  button {
    justify-self: start; font: 500 var(--fs-0) var(--sans); letter-spacing: 0.14em; text-transform: uppercase;
    background: var(--carvao); color: var(--areia); border: 0; padding: 1rem 1.8rem; cursor: pointer;
    box-shadow: inset 0 -3px 0 var(--laranja);
  }
  @media (max-width: 900px) { .grade, .linha { grid-template-columns: 1fr; } }
</style>
