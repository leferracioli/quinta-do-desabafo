---
// Foto da Letícia dentro do arco.
// - foto="recorte" (padrão): a cabeça "vaza" por cima do arco; os lados e a base ficam presos nele.
// - foto="sorrindo" | "pensativa": a foto inteira preenche o arco (sem vazar), para variar o site.
import { Picture } from 'astro:assets';
import recorte from '../assets/leticia-recorte.webp';
import sorrindo from '../assets/fotos/leticia-sorrindo.webp';
import pensativa from '../assets/fotos/leticia-pensativa.webp';

const FOTOS = { sorrindo, pensativa };

interface Props {
  /** qual foto usar (padrão: o recorte com a cabeça vazando o arco) */
  foto?: 'recorte' | 'sorrindo' | 'pensativa';
  /** true na capa (acima da dobra): carrega na hora, com prioridade */
  prioridade?: boolean;
  /** true quando a foto é só decorativa (alt vazio) */
  decorativo?: boolean;
  /** valor do atributo sizes */
  sizes?: string;
  class?: string;
}
// No recorte, a foto ocupa 104% da largura do arco: o sizes considera isso para o navegador não ampliar a imagem
const { foto = 'recorte', prioridade = false, decorativo = false, sizes = '(max-width: 900px) 76vw, 520px', class: classe } = Astro.props;
const alt = decorativo ? '' : 'Letícia Ferracioli';
---
{foto === 'recorte' ? (
  <figure class:list={['retrato', classe]} aria-hidden={decorativo ? 'true' : undefined}>
    <div class="retrato-fundo"></div>
    <div class="retrato-clip">
      <Picture
        src={recorte}
        formats={['avif', 'webp']}
        widths={[240, 360, 480, 640, 800, 940]}
        quality={88}
        sizes={sizes}
        alt={alt}
        loading={prioridade ? 'eager' : 'lazy'}
        fetchpriority={prioridade ? 'high' : 'auto'}
      />
    </div>
  </figure>
) : (
  <figure class:list={['retrato', 'retrato-inteiro', `foto-${foto}`, classe]} aria-hidden={decorativo ? 'true' : undefined}>
    <Picture
      src={FOTOS[foto]}
      formats={['avif', 'webp']}
      widths={[240, 360, 480, 640, 800, 1000]}
      quality={85}
      sizes={sizes}
      alt={alt}
      loading={prioridade ? 'eager' : 'lazy'}
      fetchpriority={prioridade ? 'high' : 'auto'}
    />
  </figure>
)}

<style>
  .retrato { position: relative; aspect-ratio: 3 / 4; margin: 0; }
  .retrato-fundo {
    position: absolute; inset: 0;
    border-radius: 999px 999px 0 0;
    background: linear-gradient(165deg, var(--pedra), var(--taupe));
  }
  .retrato-clip {
    position: absolute; left: 0; right: 0; bottom: 0; top: -30%;
    /* acima da linha onde a curva do arco termina (52%), o recorte é mais largo: o cabelo pode vazar */
    clip-path: polygon(-15% 0, 115% 0, 115% 52%, 100% 52%, 100% 100%, 0 100%, 0 52%, -15% 52%);
  }
  .retrato-clip :global(img) {
    position: absolute; width: 104%; max-width: none; height: auto; left: -2%; top: 10.6%;
  }

  /* Foto inteira dentro do arco */
  .retrato-inteiro { overflow: hidden; border-radius: 999px 999px 0 0; background: var(--pedra); }
  .retrato-inteiro :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .foto-sorrindo :global(img) { object-position: 45% 20%; }
  .foto-pensativa :global(img) { object-position: 45% 35%; }
</style>
