---
const atual = Astro.url.pathname;
const ativo = (href: string) => (atual.startsWith(href) ? 'page' : undefined);
---
<header class="topo escuro">
  <div class="wrap">
    <a class="marca" href="/">Letícia <em>Ferracioli</em></a>
    <nav aria-label="Principal">
      <a class="link" href="/solucoes/" aria-current={ativo('/solucoes')}>Soluções</a>
      <a class="link" href="/desabafos/" aria-current={ativo('/desabafos')}><span class="longo">Quinta do </span>Desabafo</a>
      <a class="link sobre" href="/sobre/" aria-current={ativo('/sobre')}>Sobre</a>
      <a class="link" href="/contato/" aria-current={ativo('/contato')}>Contato</a>
    </nav>
  </div>
</header>

<style>
  .topo .wrap {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding-block: 22px;
    font-size: var(--fs-0); letter-spacing: 0.16em; text-transform: uppercase;
  }
  .marca {
    font-family: var(--serif); font-weight: var(--peso-serif);
    font-size: 1.45rem; letter-spacing: 0; text-transform: none;
    text-decoration: none; white-space: nowrap;
  }
  .marca em { color: var(--laranja-luz); }
  nav { display: flex; gap: 1.8rem; }
  nav a { text-decoration: none; white-space: nowrap; }
  nav a[aria-current='page'] { background-size: 100% 2px; }
  @media (max-width: 1000px) {
    .longo { display: none; }
  }
  @media (max-width: 760px) {
    .topo .wrap { flex-direction: column; align-items: flex-start; gap: 0.8rem; padding-block: 16px; }
    .marca { font-size: 1.3rem; }
    nav { gap: 1.2rem; font-size: 0.8rem; letter-spacing: 0.12em; }
  }
  @media (max-width: 380px) {
    .sobre { display: none; }
  }
</style>
