---
// Arquivo de todos os Desabafos, com filtro por tema.
// Cada tema é uma página estática própria (/desabafos/tema/...): zero JS e indexável.
import Base from '../layouts/Base.astro';
import ListaEdicoes from './ListaEdicoes.astro';
import { TEMAS, type Tema } from '../lib/temas';
import { temaSlug, type Artigo } from '../lib/artigos';
import { migalhas } from '../lib/seo';
import FormNewsletter from './form/FormNewsletter.astro';

// inicio: true em /desabafos (abre com um resumo do que é a Quinta do Desabafo)
interface Props { artigos: Artigo[]; tema?: Tema; inicio?: boolean }
const { artigos, tema, inicio = false } = Astro.props;
const lista = tema ? artigos.filter((a) => a.data.tema === tema) : artigos;
const total = lista.length;

const titulo = tema ? `Desabafos sobre ${tema}` : 'Quinta do Desabafo';
const descricao = tema
  ? `Todos os artigos da Quinta do Desabafo sobre ${tema}, por Letícia Ferracioli.`
  : 'Quinta do Desabafo, o blog de Letícia Ferracioli: toda quinta, uma notícia sobre vendas, gestão comercial, IA ou marketing digital, além da manchete.';
const caminho = tema ? `/desabafos/tema/${temaSlug(tema)}/` : '/desabafos/';
const jsonLd = [
  { '@type': 'CollectionPage', name: titulo, url: new URL(caminho, Astro.site).href, inLanguage: 'pt-BR' },
  migalhas(Astro.site!, [
    { nome: 'Início', caminho: '/' },
    { nome: 'Quinta do Desabafo', caminho: '/desabafos/' },
    ...(tema ? [{ nome: tema, caminho }] : []),
  ]),
];
---
<Base title={tema ? `${titulo} · Quinta do Desabafo` : 'Quinta do Desabafo · Letícia Ferracioli'} description={descricao} jsonLd={jsonLd}>
  {inicio ? (
    <header class="intro escuro">
      <div class="wrap intro-grade">
        <div>
          <p class="kicker">Toda quinta-feira · por Letícia Ferracioli</p>
          <h1>Quinta do <span class="destaque">Desabafo</span></h1>
        </div>
        <div class="intro-texto">
          <p class="intro-lead">Toda semana, eu escolho uma notícia sobre vendas, gestão comercial, inteligência artificial ou marketing digital e vou além da manchete: pesquiso, busco os dados, consulto as fontes e trago a minha visão de quem está na operação.</p>
          <p>No Instagram, trago a provocação. Aqui, aprofundo a conversa.</p>
          <ul class="assuntos" aria-label="Assuntos">
            <li>Vendas e gestão comercial</li>
            <li>IA aplicada ao trabalho</li>
            <li>Marketing digital</li>
            <li>CRM, automações e processos</li>
          </ul>
          <a class="link" href="/sobre/">Como a Quinta do Desabafo nasceu →</a>
        </div>
      </div>
    </header>
  ) : (
  <header class="topo-arquivo escuro">
    <div class="wrap">
      <p class="kicker">Arquivo</p>
      <h1>{tema ? <>Desabafos sobre <span class="destaque">{tema}</span></> : <>Todos os <span class="destaque">Desabafos</span></>}</h1>
      <p class="contagem">{total === 0 ? 'Nenhuma edição ainda' : total === 1 ? '1 edição' : `${total} edições`}</p>
    </div>
  </header>
  )}

  <div class="wrap corpo-arquivo">
    {inicio && <h2 class="todas">Todas as edições</h2>}
    <nav class="filtro" aria-label="Filtrar por tema">
      <a href="/desabafos/" aria-current={!tema ? 'page' : undefined}>Todos</a>
      {TEMAS.map((t) => (
        <a href={`/desabafos/tema/${temaSlug(t)}/`} aria-current={t === tema ? 'page' : undefined}>{t}</a>
      ))}
    </nav>

    {total > 0 ? (
      <ListaEdicoes artigos={lista} nivel="h2" />
    ) : (
      <p class="vazio">
        {tema ? <>Ainda não tem desabafo sobre {tema}. <a class="link" href="/desabafos/">Ver todos →</a></> : 'A primeira edição sai na próxima quinta.'}
      </p>
    )}
  </div>
  {inicio && <FormNewsletter />}
</Base>

<style>
  .topo-arquivo { padding-block: clamp(56px, 8vw, 110px) clamp(40px, 6vw, 72px); }
  h1 { font-size: clamp(var(--fs-4), 7vw, var(--fs-7)); letter-spacing: -0.02em; margin: 0.3em 0 0.3em; max-width: 16ch; }
  .contagem { color: var(--taupe); font-size: var(--fs-0); letter-spacing: 0.14em; text-transform: uppercase; margin: 0; }
  .corpo-arquivo { padding-block: clamp(40px, 6vw, 72px) clamp(64px, 10vw, 140px); }
  .filtro {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.8rem; margin-bottom: clamp(32px, 5vw, 56px);
    font-size: var(--fs-0); letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500;
  }
  .filtro a {
    text-decoration: none; color: var(--taupe-tinta); padding-bottom: 4px;
    background: linear-gradient(var(--laranja), var(--laranja)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.35s ease, color 0.2s;
  }
  .filtro a:hover { color: var(--carvao); background-size: 100% 2px; }
  .filtro a[aria-current='page'] { color: var(--carvao); background-size: 100% 2px; }
  .intro { padding-block: clamp(56px, 8vw, 110px); }
  .intro-grade { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); align-items: end; }
  .intro h1 { margin-bottom: 0; }
  .intro-lead { font-size: var(--fs-2); line-height: 1.45; margin-top: 0; }
  .intro-texto p { max-width: 44ch; }
  .assuntos { list-style: none; padding: 0; margin: 1.4rem 0 1.6rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .assuntos li { border: 1px solid var(--linha-escura); padding: 0.35rem 0.8rem; font-size: var(--fs-0); letter-spacing: 0.06em; color: var(--areia); }
  .intro .link { font-weight: 500; }
  @media (max-width: 900px) {
    .intro-grade { grid-template-columns: 1fr; }
    .intro-lead { font-size: 1.3rem; }
  }
  .todas { font-size: var(--fs-3); font-style: italic; border-top: 1px solid var(--carvao); padding-top: 1.2rem; margin: 0 0 1.4rem; }
  .vazio { color: var(--taupe-tinta); border-top: 1px solid var(--pedra); padding-top: 1.2rem; }
</style>
