---
// Página curta de retorno dos formulários (obrigado / envio falhou). Não é indexada.
import Base from '../layouts/Base.astro';
interface Props { titulo: string; destaque: string; texto: string; pageTitle: string }
const { titulo, destaque, texto, pageTitle } = Astro.props;
const i = titulo.indexOf(destaque);
---
<Base title={pageTitle} description={texto} naoIndexar>
  <section class="aviso escuro">
    <div class="wrap">
      <h1>{titulo.slice(0, i)}<span class="destaque">{destaque}</span>{titulo.slice(i + destaque.length)}</h1>
      <p class="texto">{texto}</p>
      <slot />
    </div>
  </section>
</Base>

<style>
  .aviso { min-height: 70svh; display: flex; align-items: center; padding-block: clamp(64px, 10vw, 140px); }
  h1 { font-size: clamp(var(--fs-4), 7vw, var(--fs-6)); letter-spacing: -0.02em; margin: 0 0 0.4em; max-width: 14ch; }
  .texto { font-size: var(--fs-2); line-height: 1.45; max-width: 36ch; margin: 0 0 1.6em; }
  .aviso :global(nav) { display: flex; flex-wrap: wrap; gap: 1rem 2.4rem; font-weight: 500; align-items: center; }
</style>
