---
// Eventos para o Google Tag Manager (dataLayer). Sem aceite de cookies, o GTM
// não carrega e esses eventos não saem do navegador.
//   clique_whatsapp → clique em qualquer link do WhatsApp
//   generate_lead   → formulário de contato enviado (página /obrigado/)
//   sugestao_tema   → sugestão de tema enviada (página /obrigado-tema/)
//   sign_up         → inscrição na newsletter enviada (página /newsletter/confirme/)
//   newsletter_confirmada → pessoa clicou no link de confirmação (página /newsletter/confirmada/)
---
<script>
  type Evento = Record<string, unknown>;
  const w = window as unknown as { dataLayer: Evento[] };
  w.dataLayer = w.dataLayer || [];
  const enviar = (e: Evento) => w.dataLayer.push(e);

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href*="wa.me"]');
    if (link) enviar({ event: 'clique_whatsapp', local_clique: (link.textContent ?? '').trim().slice(0, 60) });
  });

  const caminho = location.pathname;
  if (caminho.startsWith('/newsletter/confirme')) enviar({ event: 'sign_up', method: 'newsletter' });
  else if (caminho.startsWith('/newsletter/confirmada')) enviar({ event: 'newsletter_confirmada' });
  else if (caminho.startsWith('/obrigado-tema')) enviar({ event: 'sugestao_tema' });
  else if (caminho.startsWith('/obrigado')) enviar({ event: 'generate_lead', tipo_lead: 'formulario' });
</script>
