---
// Botão para conversar no WhatsApp, já com a mensagem "Tenho interesse na sua Mentoria/Consultoria".
import { SITE } from '../lib/site';
interface Props { texto?: string; variante?: 'claro' | 'escuro' }
const { texto = 'Conversar no WhatsApp', variante = 'escuro' } = Astro.props;
---
<a class:list={['zap', variante]} href={SITE.whatsapp} target="_blank" rel="noopener">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.2.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3Z"/></svg>
  <span>{texto}</span>
</a>

<style>
  .zap {
    display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none;
    font: 500 var(--fs-0) var(--sans); letter-spacing: 0.12em; text-transform: uppercase;
    padding: 1rem 1.6rem; box-shadow: inset 0 -3px 0 var(--laranja); transition: transform 0.2s;
  }
  .zap:hover { transform: translateY(-1px); }
  .escuro { background: var(--carvao); color: var(--areia); }
  .claro { background: var(--areia); color: var(--carvao); }
</style>
